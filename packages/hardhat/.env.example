# Template for Hardhat environment variables.

# For local development, copy this file, rename it to .env, and fill in the values.

# If not set, we provide default values (check `hardhat.config.ts`) so developers can start prototyping out of the box,
# but we recommend getting your own API keys for production / Sepolia work.

# To access the values stored in this .env file you can use: process.env.VARIABLENAME

# Alchemy API key — used for Sepolia (and other) RPC URLs in hardhat.config.ts.
# Same variable name as packages/nextjs (ALCHEMY_API_KEY). Get a key at https://dashboard.alchemy.com
ALCHEMY_API_KEY=

# Optional: contract verification on Etherscan / block explorers
ETHERSCAN_API_KEY=

# Don't fill this value manually. Run `yarn generate` for a new account or `yarn account:import` to import an existing PK.
# Not required for the Aave Sepolia frontend integration (no custom market is deployed from this package).
DEPLOYER_PRIVATE_KEY_ENCRYPTED=
